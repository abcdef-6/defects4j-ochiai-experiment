def compute_ochiai(stmt_data, total_failed):
    scores = []
    for stmt, (f, p) in stmt_data.items():
        if f == 0:
            continue
        ochiai = f / math.sqrt(total_failed * (f + p))
        scores.append((ochiai, stmt))
    scores.sort(key=lambda x: x[0], reverse=True)
    return scores

def main():

    if not os.path.exists("failing_tests"):
        print("Error: failing_tests not found")
        sys.exit(1)
    with open("failing_tests") as f:
        failing = [line.strip() for line in f if line.strip()]
    total_failed = len(failing)
    print(f"Total failed tests: {total_failed}")
    

    stmt_data = parse_coverage("coverage.xml", failing)
    

    scores = compute_ochiai(stmt_data, total_failed)
    

    print("\nOchiai suspect ranking (Top-10):")
    for rank, (score, stmt) in enumerate(scores[:10], 1):
        print(f"Top{rank}: {stmt:20} -> {score:.4f}")

if __name__ == "__main__":
